---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
---

<BaseLayout
  title="Tailored Resume"
  description="Private resume tailoring tool"
  noindex
>
  <div class="no-print">
    <ThemeToggle />
  </div>

  <div
    class="no-print fixed top-4 left-4 z-50 flex gap-2"
  >
    <a
      href="/tailor"
      class="rounded-lg bg-gray-700 hover:bg-gray-800 dark:bg-gray-600 dark:hover:bg-gray-500 text-white text-sm font-semibold px-4 py-2 transition-colors"
    >
      ← Back
    </a>
    <button
      id="download-btn"
      type="button"
      class="rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold px-4 py-2 transition-colors"
    >
      Download PDF
    </button>
  </div>

  <div id="warnings" class="no-print hidden max-w-3xl mx-auto px-6 pt-20">
    <div
      class="p-3 rounded-lg bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 text-sm"
    >
      <p class="font-semibold mb-1">Faithfulness warnings:</p>
      <ul id="warnings-list" class="list-disc pl-5 space-y-1"></ul>
    </div>
  </div>

  <main id="resume-root" class="max-w-3xl mx-auto px-6 py-10">
    <p id="not-found" class="hidden text-center text-gray-500 dark:text-gray-400 pt-16">
      That tailored resume wasn't found in this browser's history.
      <a href="/tailor" class="text-orange-600 dark:text-orange-400 hover:underline">Back to Resume Tailor</a>
    </p>
  </main>
</BaseLayout>

<script>
  import { HISTORY_STORAGE_KEY, type HistoryEntry } from "../../lib/tailor-types";
  import { renderTailoredResume } from "../../lib/render-tailored";

  const root = document.getElementById("resume-root") as HTMLElement;
  const notFound = document.getElementById("not-found") as HTMLElement;
  const downloadBtn = document.getElementById("download-btn") as HTMLButtonElement;
  const warningsBox = document.getElementById("warnings") as HTMLElement;
  const warningsList = document.getElementById("warnings-list") as HTMLElement;

  const id = new URLSearchParams(window.location.search).get("id");
  let entry: HistoryEntry | undefined;
  try {
    const raw = localStorage.getItem(HISTORY_STORAGE_KEY);
    const entries: HistoryEntry[] = raw ? JSON.parse(raw) : [];
    entry = entries.find((e) => e.id === id);
  } catch {
    entry = undefined;
  }

  if (!entry) {
    notFound.classList.remove("hidden");
    downloadBtn.disabled = true;
  } else {
    root.insertAdjacentHTML("afterbegin", renderTailoredResume(entry));

    if (entry.warnings?.length) {
      for (const warning of entry.warnings) {
        const li = document.createElement("li");
        li.textContent = warning;
        warningsList.append(li);
      }
      warningsBox.classList.remove("hidden");
    }

    downloadBtn.addEventListener("click", () => {
      const original = document.title;
      const company = entry!.company.replace(/[^a-z0-9]+/gi, "_").replace(/^_+|_+$/g, "");
      document.title = `Michael_Bazos_Resume_${company || "Tailored"}`;
      window.print();
      document.title = original;
    });
  }
</script>

<style is:global>
  @page {
    size: letter;
    margin: 9mm 11mm;
  }

  @media print {
    /* Tailwind spacing is rem-based, so shrinking the root font scales the
       whole layout — a fit safety-margin on top of the prompt's content budget. */
    html {
      font-size: 12px;
    }

    .no-print,
    [id="theme-toggle"] {
      display: none !important;
    }

    body {
      background: white !important;
      color: #111827 !important;
    }

    html.dark body,
    html.dark main {
      background: white !important;
      color: #111827 !important;
    }

    main {
      max-width: none !important;
      padding: 0 !important;
    }

    /* Tighten vertical rhythm so a max-budget resume (4 jobs × 3 bullets)
       still fits a single Letter page. */
    #resume-root header {
      margin-bottom: 0.75rem !important;
    }

    #resume-root section {
      margin-bottom: 0.75rem !important;
    }

    #resume-root section h2 {
      margin-bottom: 0.4rem !important;
    }

    .tailored-entry {
      margin-bottom: 0.5rem !important;
    }

    h1, h2, h3 {
      color: #111827 !important;
    }

    .text-orange-600,
    .dark\:text-orange-400 {
      color: #ea580c !important;
    }

    .text-gray-600,
    .dark\:text-gray-400 {
      color: #4b5563 !important;
    }

    .text-gray-700,
    .dark\:text-gray-300 {
      color: #374151 !important;
    }

    .text-gray-500 {
      color: #6b7280 !important;
    }

    .bg-gray-50,
    .dark\:bg-gray-800 {
      background-color: #f9fafb !important;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .border-blue-600,
    .dark\:border-blue-400 {
      border-color: #2563eb !important;
    }

    a {
      color: #ea580c !important;
      text-decoration: none !important;
    }

    .tailored-entry {
      break-inside: avoid;
    }

    h2 {
      break-after: avoid;
    }
  }
</style>
