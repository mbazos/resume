# Copy to .env for local development. Set the same three variables in the
# Netlify dashboard (Site configuration → Environment variables) for production.

# Google Gemini API key — create one at https://aistudio.google.com/ ("Get API key")
GEMINI_API_KEY=

# Password for the private /tailor pages (pick something strong)
TAILOR_PASSWORD=

# Secret for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=
